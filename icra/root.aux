\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces $R$, raw 3D-TTC, and PET as the ego path of one DeepAccident collision instance is shifted laterally by $\delta $ (top: each score min--max normalized; bottom: raw scale). Raw 3D-TTC and PET each jump from one extreme to the other at a single offset; $R$ changes smoothly throughout.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:perturbation_sweep}{{7}{10}{$R$, raw 3D-TTC, and PET as the ego path of one DeepAccident collision instance is shifted laterally by $\delta $ (top: each score min--max normalized; bottom: raw scale). Raw 3D-TTC and PET each jump from one extreme to the other at a single offset; $R$ changes smoothly throughout}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-timestep risk along the ego path for two real DeepAccident instances (rows) under four methods (columns): a near-miss safely avoided (top; native collision label $=0$) and a collision missed entirely by the fixed-horizon geometric criterion (bottom; native collision label $=1$, contact at $t=4.0$s). Path color is that method's own per-frame score (green=low, red=high); FutureRisk, RSS, and raw 3D-TTC share one fixed $[0,1]$ color scale, while GSSM's unbounded intensity is normalized to each row's own observed range (its own colorbar). Gray dashed path is the interacting agent; \textsf  {X} marks the native-confirmed collision contact; \textsf  {o} marks the closest-approach frame on the near-miss row, where no collision occurs.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative_per_timestep_comparison}{{5}{10}{Per-timestep risk along the ego path for two real DeepAccident instances (rows) under four methods (columns): a near-miss safely avoided (top; native collision label $=0$) and a collision missed entirely by the fixed-horizon geometric criterion (bottom; native collision label $=1$, contact at $t=4.0$s). Path color is that method's own per-frame score (green=low, red=high); FutureRisk, RSS, and raw 3D-TTC share one fixed $[0,1]$ color scale, while GSSM's unbounded intensity is normalized to each row's own observed range (its own colorbar). Gray dashed path is the interacting agent; \textsf {X} marks the native-confirmed collision contact; \textsf {o} marks the closest-approach frame on the near-miss row, where no collision occurs}{figure.5}{}}
